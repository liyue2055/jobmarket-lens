{
  "name": "jobmarket-lens-node25",
  "version": "2.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "web": "vite --host 0.0.0.0",
    "build": "node scripts/materialize.mjs && npm run check && vite build",
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "data:import": "node scripts/import-upstream.mjs",
    "data:materialize": "node scripts/materialize.mjs",
    "data:validate": "node scripts/materialize.mjs --verify",
    "test:e2e": "playwright test",
    "data:parity": "node scripts/audit-parity.mjs",
    "data:migrate": "node scripts/migrate-history.mjs",
    "check": "tsc --noEmit",
    "data:pull-candidate": "node scripts/pull-snapshot.mjs"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@react-three/fiber": "9.8.2",
    "@vitejs/plugin-react": "4.7.0",
    "ajv": "8.20.0",
    "csv-parse": "7.0.3",
    "echarts": "6.1.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.186.1",
    "vite": "6.4.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
